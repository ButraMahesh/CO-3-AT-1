import numpy as np
from hmmlearn import hmm
import sklearn_crfsuite

print("Name: B Mahesh")
print("Register Number: 192425338")
print("\nDRIVING ACTIVITY RECOGNITION USING HMM AND CRF\n")

states = ["Straight", "Turning", "Braking", "Stopping"]

model = hmm.CategoricalHMM(n_components=4)

model.startprob_ = np.array([0.6, 0.2, 0.15, 0.05])

model.transmat_ = np.array([
    [0.6, 0.2, 0.15, 0.05],
    [0.3, 0.5, 0.15, 0.05],
    [0.1, 0.2, 0.5, 0.2],
    [0.2, 0.1, 0.3, 0.4]
])

model.emissionprob_ = np.array([
    [0.8, 0.15, 0.05],
    [0.2, 0.6, 0.2],
    [0.1, 0.3, 0.6],
    [0.05, 0.15, 0.8]
])

observations = np.array([
    [0],
    [0],
    [1],
    [2],
    [2]
])

log_probability, hidden_states = model.decode(
    observations,
    algorithm="viterbi"
)

print("HMM Predicted Activities:")

for state in hidden_states:
    print(states[state])

train_data = [
    (
        ["high_speed", "straight_steering", "normal_acceleration"],
        ["STRAIGHT", "STRAIGHT", "STRAIGHT"]
    ),
    (
        ["medium_speed", "left_steering", "normal_acceleration"],
        ["TURNING", "TURNING", "TURNING"]
    ),
    (
        ["high_speed", "negative_acceleration", "brake_active"],
        ["BRAKING", "BRAKING", "BRAKING"]
    ),
    (
        ["low_speed", "zero_acceleration", "vehicle_stopped"],
        ["STOPPING", "STOPPING", "STOPPING"]
    )
]

def word_features(sentence, i):
    word = sentence[i]

    features = {
        "sensor": word,
        "lowercase": word.lower(),
        "prefix": word[:3],
        "suffix": word[-3:]
    }

    if i > 0:
        features["previous_sensor"] = sentence[i - 1]
    else:
        features["BOS"] = True

    if i < len(sentence) - 1:
        features["next_sensor"] = sentence[i + 1]
    else:
        features["EOS"] = True

    return features

def sentence_features(sentence):
    return [
        word_features(sentence, i)
        for i in range(len(sentence))
    ]

X_train = [
    sentence_features(sentence)
    for sentence, labels in train_data
]

y_train = [
    labels
    for sentence, labels in train_data
]

crf = sklearn_crfsuite.CRF(
    algorithm="lbfgs",
    max_iterations=100
)

crf.fit(X_train, y_train)

test_sequence = [
    "high_speed",
    "negative_acceleration",
    "brake_active"
]

X_test = [
    sentence_features(test_sequence)
]

prediction = crf.predict(X_test)

print("\nCRF Predicted Activities:")

for sensor, activity in zip(test_sequence, prediction[0]):
    print(sensor, ":", activity)

print("\nFinal Prediction:")
print("HMM Final Activity:", states[hidden_states[-1]])
print("CRF Final Activity:", prediction[0][-1])
